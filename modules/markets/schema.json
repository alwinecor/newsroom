{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "markets weekly digest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "issue_date",
    "window",
    "markets"
  ],
  "properties": {
    "module": {
      "const": "markets"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "markets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold",
        "us_equities",
        "china_equities"
      ],
      "properties": {
        "gold": {
          "$ref": "#/$defs/market_report"
        },
        "us_equities": {
          "$ref": "#/$defs/market_report"
        },
        "china_equities": {
          "$ref": "#/$defs/market_report"
        }
      }
    }
  },
  "$defs": {
    "market_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institutional_views"
      ],
      "properties": {
        "institutional_views": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "institution",
              "original_title",
              "published_at",
              "url",
              "summary_zh"
            ],
            "properties": {
              "institution": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "original_title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "published_at": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://[^\\s/?#]+[^\\s]*$"
              },
              "summary_zh": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  }
}
