{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "markets weekly digest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "issue_date",
    "window",
    "markets"
  ],
  "properties": {
    "module": {
      "const": "markets"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "markets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "us_equities",
        "china_equities",
        "gold"
      ],
      "properties": {
        "us_equities": {
          "$ref": "#/$defs/market_report"
        },
        "china_equities": {
          "$ref": "#/$defs/market_report"
        },
        "gold": {
          "$ref": "#/$defs/market_report"
        }
      }
    }
  },
  "$defs": {
    "market_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot",
        "institutional_views"
      ],
      "properties": {
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "as_of",
            "summary_zh",
            "sources"
          ],
          "properties": {
            "as_of": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "summary_zh": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_name",
                  "source_title",
                  "url"
                ],
                "properties": {
                  "source_name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "source_title": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://[^\\s/?#]+[^\\s]*$"
                  }
                }
              }
            }
          }
        },
        "institutional_views": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "institution",
              "original_title",
              "published_at",
              "url",
              "summary_zh"
            ],
            "properties": {
              "institution": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "original_title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "published_at": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://[^\\s/?#]+[^\\s]*$"
              },
              "summary_zh": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  }
}
